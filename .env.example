# setup.sh generates an administrator password. This is NOT your Instagram password.
ADMIN_PASSWORD=replace-with-a-long-random-password
COOKIE_SECURE=0
# When using an HTTPS reverse proxy, set COOKIE_SECURE=1 and PUBLIC_ORIGIN.
# PUBLIC_ORIGIN=https://organizer.example.com
# Optional: enabling AI in the UI sends collected snippets to OpenAI (API charges apply).
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Firebase deploy.sh configures these automatically on Cloud Run.
# STORE_BACKEND=firestore
# GOOGLE_CLOUD_PROJECT=your-project-id
# FIRESTORE_DATABASE=(default)
# ORGANIZER_STATE_BUCKET=your-private-state-bucket
