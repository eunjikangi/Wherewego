{
  "manifest_version": 3,
  "name": "Wherewego · PC에서 가져오기",
  "description": "로그인된 PC Instagram의 저장함·DM 공유 게시물과 게시물 사진·슬라이드·영상 프레임을 직접 가져옵니다.",
  "version": "0.2.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wherewego PC 수집"
  },
  "minimum_chrome_version": "102"
}
